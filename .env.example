# Non-secret allowlist. Use the platform-authenticated account user ID.
ADMIN_ACCOUNT_USER_IDS=

# Razorpay server credentials. Never expose secrets through NEXT_PUBLIC_*.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Shiprocket server credentials and exact configured pickup location.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_PICKUP_LOCATION=

# Remains unset until a contracted notification adapter is implemented.
NOTIFICATION_PROVIDER=

